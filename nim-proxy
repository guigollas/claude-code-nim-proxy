#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="$HOME/.config/nim-proxy/nvidia.env"
PROXY_DIR="$HOME/70_RUNTIME_LOCAL/AI/Agents/claude-code-nim-proxy"
STACK="${1:-default}"

if [[ "$STACK" == "default" ]]; then
  CONFIG_FILE="$PROXY_DIR/nim_config.yaml"
else
  CONFIG_FILE="$PROXY_DIR/nim_config.$STACK.yaml"
fi
PORT="4000"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Erro: arquivo de chave não encontrado:"
  echo "$ENV_FILE"
  exit 1
fi

source "$ENV_FILE"

# Compatibilidade: aceita NVIDIA_API_KEY ou NVIDIA_NIM_API_KEY
if [[ -z "${NVIDIA_NIM_API_KEY:-}" && -n "${NVIDIA_API_KEY:-}" ]]; then
  export NVIDIA_NIM_API_KEY="$NVIDIA_API_KEY"
fi

if [[ -z "${NVIDIA_API_KEY:-}" && -n "${NVIDIA_NIM_API_KEY:-}" ]]; then
  export NVIDIA_API_KEY="$NVIDIA_NIM_API_KEY"
fi

if [[ -z "${NVIDIA_NIM_API_KEY:-}" ]]; then
  echo "Erro: NVIDIA_NIM_API_KEY não definida em:"
  echo "$ENV_FILE"
  echo ""
  echo "Coloque no arquivo:"
  echo 'export NVIDIA_NIM_API_KEY="sua-chave-da-nvidia"'
  exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Erro: nim_config.yaml não encontrado em:"
  echo "$CONFIG_FILE"
  exit 1
fi

echo "Iniciando LiteLLM real em http://127.0.0.1:4001 ..."
echo "Iniciando NIM rate guard em http://127.0.0.1:4000 ..."
echo "Claude Code deve continuar apontando para http://localhost:4000"
echo ""

cd "$PROXY_DIR"

export NIM_GUARD_UPSTREAM="http://127.0.0.1:4001"
export NIM_GUARD_PORT="4000"
export NIM_GUARD_429_COOLDOWN="65"
export NIM_GUARD_MIN_GAP="1.7"
export NIM_GUARD_MAX_429_RETRIES="1"

if [[ -x "$PROXY_DIR/.venv/bin/litellm" ]]; then
  "$PROXY_DIR/.venv/bin/litellm" --config "$CONFIG_FILE" --host 127.0.0.1 --port 4001 &
elif command -v litellm >/dev/null 2>&1; then
  litellm --config "$CONFIG_FILE" --host 127.0.0.1 --port 4001 &
else
  echo "Erro: LiteLLM não encontrado."
  exit 1
fi

LITELLM_PID=$!

cleanup() {
  echo ""
  echo "Encerrando LiteLLM PID $LITELLM_PID..."
  kill "$LITELLM_PID" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

sleep 3

exec "$PROXY_DIR/.venv/bin/python" "$PROXY_DIR/nim_rate_guard.py"
